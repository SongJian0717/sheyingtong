# ================================================================
# sheyingtong 部署环境变量示例
# 用法：cp .env.example .env  →  填好必填项 → docker compose up -d --build
# 本文件不含真实密钥，按 .gitignore 约定 .env 不入库。
# ================================================================

# ---------- 必填 ----------

# 全部 AI 能力（照片打分 / 修图建议 / AI 聊天问答）都由通义千问驱动，这是唯一必填的 AI Key
# 获取：https://dashscope.console.aliyun.com/  →  API-KEY
QWEN_API_KEY=

# JWT 签名密钥 —— 必须固定一个长随机串！
# 不设置（空）时后端每次启动都会动态生成，导致重启后所有已登录用户 token 全部失效。
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# MySQL root 密码（首次启动时由 mysql 容器初始化，请设置强密码）
# 注意：只在首次创建 mysql-data 卷时生效，改密码需见部署文档"改库密码"一节
DB_PASSWORD=

# ---------- 可选（有默认值） ----------

# RabbitMQ 凭据（默认 guest/guest，建议生产改掉）
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# 预留占位：Spring 配置里存在但当前业务代码未使用（聊天与打分都走 QWEN_API_KEY）；
# 仅当未来切换到 OpenAI 系的对话模型时才需要填。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com